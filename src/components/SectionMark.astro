---
const { kind, size = 'md', tone = 'ink', label } = Astro.props;
const title = label ?? ({
  writing: 'Writing',
  lab: 'Architecture Lab',
  experience: 'Experience',
  about: 'About'
}[kind] ?? 'Section');
---
<span class={`section-mark section-mark--${size} section-mark--${tone}`} role="img" aria-label={title}>
  {kind === 'writing' && (
    <svg viewBox="0 0 48 48" aria-hidden="true">
      <path d="M11 37.5c7.4-2.6 14.3-8 19.2-14.6 4-5.4 5.9-10.4 6.6-14.8-4.6.8-9.6 2.9-14.6 6.6-6.6 4.9-11.8 11.6-14.2 19.1" />
      <path d="M17.5 31.5 30.8 18.2" />
      <path d="M23 26.3c2.8.3 5.2 1.2 7.2 2.8" />
      <path d="M9.5 38.5h15" />
      <path d="M30 34.8h8.5c.8 0 1.5.7 1.5 1.5v3.2H28.5v-3.2c0-.8.7-1.5 1.5-1.5Z" />
    </svg>
  )}
  {kind === 'lab' && (
    <svg viewBox="0 0 48 48" aria-hidden="true">
      <path d="M10 31.5 20.5 21l9 6.3L38 15" />
      <circle cx="10" cy="31.5" r="3" />
      <circle cx="20.5" cy="21" r="3" />
      <circle cx="29.5" cy="27.3" r="3" />
      <circle cx="38" cy="15" r="3" />
      <path d="M8 39.5c8.5-1.3 18.7-1.1 31 .5" />
    </svg>
  )}
  {kind === 'experience' && (
    <svg viewBox="0 0 48 48" aria-hidden="true">
      <path d="M7.5 31.8c7.5-9.3 16.9-14 28.2-14.2" />
      <path d="M31.2 12.8 37.5 17l-5 5.3" />
      <path d="M10 35.5c6.2 2.1 12.7 2.4 19.6.9" />
      <circle cx="8.7" cy="32.8" r="2.4" />
      <circle cx="38.2" cy="16.8" r="2.4" />
    </svg>
  )}
  {kind === 'about' && (
    <svg viewBox="0 0 48 48" aria-hidden="true">
      <path d="M31.8 8.5c-2.2-1.5-5-2.2-8-1.8-5.4.7-9.4 4.6-10.3 9.9-.5 2.9.1 5.3 1.1 7.3l-2.2 3.6c-.6 1-.1 2.2 1 2.5l3.1.8c.2 3.6 1.7 6.4 4.3 8.1 2 1.3 4.2 1.8 6.6 1.4" />
      <path d="M28.5 10.4c3 1.6 4.8 4.2 5.2 7.6" />
      <path d="M22.1 16.3c2.4-1.1 4.8-.9 7 .5" />
      <path d="M24 20.6c1.6-.3 3-.1 4.1.7" />
      <circle cx="26.7" cy="20.7" r=".8" />
      <path d="M30.1 22.5c2.1 1.3 2.7 2.6 1.9 3.9-1 1.5-2.5 2.1-4.6 1.8" />
      <path d="M28.7 28.6c1.1 1 1.7 2 1.7 3.1" />
      <path d="M20.4 29.8c2.6 1.4 5.3 1.7 8.1.7" />
      <path d="M18.4 32.1c1.2 4.8 3.9 7.9 8.2 9.2 2.7.8 5.3.4 7.9-1.2" />
      <path d="M21.1 34.7c2.5 1 4.9.8 7.2-.6" />
      <path d="M23.1 38c2.2.5 4.2.1 6-1.2" />
      <path d="M34.4 40.1c2.2 1.1 3.8 2.5 4.8 4.2M25.2 41.3c-4.1.1-7.8 1.1-11.1 3" />
    </svg>
  )}
</span>
