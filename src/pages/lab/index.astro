---
import BaseLayout from '../../layouts/BaseLayout.astro';
---
<BaseLayout title="Architecture Lab — Prashant Kumar" description="Practical experiments in enterprise architecture, AI, data and digital transformation.">
  <section class="hero">
    <div class="container">
      <p class="eyebrow">Architecture Lab</p>
      <h1>Learning by building, not just reading.</h1>
      <p class="lede">A public record of practical experiments designed to test architecture ideas against working technology, real constraints and observable outcomes.</p>
    </div>
  </section>
  <section class="section">
    <div class="container grid">
      <article class="card"><div><p class="meta">01 · Active</p><h3>CRM Prototype Studio</h3><p>AI-assisted enterprise delivery across Salesforce, Snowflake and governed human approvals.</p></div><span class="card-link">Case study coming soon</span></article>
      <article class="card"><div><p class="meta">02 · Built</p><h3>Conversational Utility Experience</h3><p>Voice-first outage and planned-work interactions using Alexa and synthetic utility data.</p></div><a class="card-link" href="/lab/conversational-utility-experience/">Read the case study →</a></article>
      <article class="card"><div><p class="meta">03 · Planned</p><h3>Customer Event Digital Twin</h3><p>Testing how operational events, customer context and governed AI can create a more responsive experience.</p></div><span class="card-link">Next experiment</span></article>
      <article class="card"><div><p class="meta">04 · Planned</p><h3>One Journey, Many Channels</h3><p>Separating customer capability from the interface by exposing the same services across multiple channels.</p></div><span class="card-link">On the roadmap</span></article>
      <article class="card"><div><p class="meta">05 · Planned</p><h3>Enterprise Agent Control Plane</h3><p>A vendor-neutral experiment in agent identity, policy, authority, human approval and auditability.</p></div><span class="card-link">On the roadmap</span></article>
      <article class="card"><div><p class="meta">06 · Planned</p><h3>Architecture Intelligence</h3><p>Exploring what changes when architecture knowledge, decisions and models become machine-readable.</p></div><span class="card-link">On the roadmap</span></article>
    </div>
  </section>
</BaseLayout>
