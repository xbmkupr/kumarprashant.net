---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';

const entries = (await getCollection('experiments')).sort((a, b) => a.data.experimentNo - b.data.experimentNo);
const tags = [...new Set(entries.flatMap((entry) => entry.data.tags))].sort();
---
<BaseLayout title="Architecture Lab — Prashant Kumar" description="Practical experiments in enterprise architecture, AI, data and digital transformation.">
  <section class="hero">
    <div class="container">
      <p class="eyebrow">Architecture Lab</p>
      <h1>Learning by building, not just reading.</h1>
      <p class="lede">A public record of practical experiments designed to test architecture ideas against working technology, real constraints and observable outcomes.</p>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="content-toolbar" aria-label="Filter experiments by topic">
        <button class="filter-chip is-active" type="button" data-filter="all">All</button>
        {tags.map((tag) => <button class="filter-chip" type="button" data-filter={tag}>{tag}</button>)}
      </div>

      <div class="grid content-grid" id="experiment-grid">
        {entries.map((entry) => (
          <article class="card content-card" data-tags={entry.data.tags.join('|')}>
            <div>
              <p class="meta">{String(entry.data.experimentNo).padStart(2, '0')} · {entry.data.status}</p>
              <h3>{entry.data.title}</h3>
              <p>{entry.data.summary ?? entry.data.description}</p>
              <div class="tag-list" aria-label="Topics">
                {entry.data.tags.slice(0, 4).map((tag) => <a class="tag-pill" href={`/tags/${encodeURIComponent(tag.toLowerCase().replace(/[^a-z0-9]+/g, '-').replace(/^-|-$/g, ''))}/`}>{tag}</a>)}
              </div>
            </div>
            {entry.data.status === 'published'
              ? <a class="card-link" href={`/lab/${entry.id}/`}>Read the case study →</a>
              : <span class="card-link">{entry.data.status === 'active' ? 'In progress' : 'On the roadmap'}</span>}
          </article>
        ))}
      </div>
    </div>
  </section>

  <script is:inline>
    const chips = [...document.querySelectorAll('.filter-chip')];
    const cards = [...document.querySelectorAll('.content-card')];
    chips.forEach((chip) => chip.addEventListener('click', () => {
      const filter = chip.getAttribute('data-filter');
      chips.forEach((item) => item.classList.toggle('is-active', item === chip));
      cards.forEach((card) => {
        const tags = (card.getAttribute('data-tags') || '').split('|');
        card.hidden = filter !== 'all' && !tags.includes(filter);
      });
    }));
  </script>
</BaseLayout>
