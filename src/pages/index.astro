---
import BaseLayout from '../layouts/BaseLayout.astro';
---
<BaseLayout>
  <section class="brand-hero">
    <div class="container brand-hero-grid">
      <div class="brand-hero-copy">
        <p class="eyebrow">Enterprise strategy · Architecture · AI</p>
        <h1>The future refuses<br/>to follow the <em>roadmap.</em></h1>
        <p class="brand-hero-lede">I help organisations make consequential technology choices with clarity — connecting strategy, architecture and delivery while preserving the freedom to adapt.</p>
        <div class="brand-hero-actions">
          <a class="button button-dark" href="/about/">About me</a>
          <a class="text-link" href="/writing/">Read my thinking →</a>
        </div>
      </div>

      <figure class="brand-portrait">
        <div class="brand-portrait-frame">
          <img src="/prashant-kumar-local.svg" alt="Prashant Kumar" />
        </div>
        <figcaption>
          <span>Adelaide, Australia</span>
          <span>Working globally</span>
        </figcaption>
      </figure>
    </div>
  </section>

  <section class="brand-statement">
    <div class="container brand-statement-grid">
      <p class="eyebrow eyebrow-light">My perspective</p>
      <blockquote>Architecture earns its place when it improves the quality, speed and reversibility of decisions.</blockquote>
      <p>I work where strategy meets the reality of delivery — legacy estates, regulation, emerging technology, competing priorities and decisions that are expensive to reverse.</p>
    </div>
  </section>

  <section class="brand-paths">
    <div class="container">
      <div class="brand-paths-intro">
        <p class="eyebrow">Explore</p>
        <h2>A few ways into my work.</h2>
      </div>
      <nav class="brand-path-grid" aria-label="Explore Prashant Kumar's work">
        <a href="/lab/"><span>01</span><strong>Architecture Lab</strong><small>Learning by building.</small><b>Explore →</b></a>
        <a href="/writing/"><span>02</span><strong>Writing</strong><small>Ideas worth pressure-testing.</small><b>Read →</b></a>
        <a href="/experience/"><span>03</span><strong>Experience</strong><small>The perspective behind the work.</small><b>View →</b></a>
        <a href="/about/"><span>04</span><strong>About</strong><small>How I think and work.</small><b>More →</b></a>
      </nav>
    </div>
  </section>

  <style>
    .brand-hero { min-height: calc(100vh - 88px); display:flex; align-items:center; }
    .brand-hero-grid { display:grid; grid-template-columns:minmax(0,1.18fr) minmax(320px,.72fr); gap:86px; align-items:center; padding:72px 0 84px; }
    .brand-hero h1 { margin:0; max-width:760px; font:400 clamp(60px,6.7vw,98px)/.96 Georgia,serif; letter-spacing:-.055em; }
    .brand-hero h1 em { color:var(--blue); font-weight:400; }
    .brand-hero-lede { max-width:660px; margin:31px 0 0; color:#46515a; font-size:20px; line-height:1.62; }
    .brand-hero-actions { display:flex; align-items:center; flex-wrap:wrap; gap:30px; margin-top:38px; }
    .brand-portrait { margin:0; }
    .brand-portrait-frame { position:relative; overflow:hidden; aspect-ratio:4/5; background:#d9d4cb; }
    .brand-portrait-frame::after { content:''; position:absolute; inset:14px; border:1px solid rgba(255,255,255,.5); pointer-events:none; }
    .brand-portrait img { width:100%; height:100%; object-fit:cover; object-position:center 37%; filter:saturate(.84) contrast(1.02); }
    .brand-portrait figcaption { display:flex; justify-content:space-between; gap:18px; margin-top:13px; color:var(--muted); font-size:11px; letter-spacing:.11em; text-transform:uppercase; }

    .brand-statement { background:var(--ink); color:var(--white); padding:82px 0; }
    .brand-statement-grid { display:grid; grid-template-columns:.55fr 1.55fr .8fr; gap:52px; align-items:start; }
    .brand-statement blockquote { margin:0; font:400 clamp(34px,3.8vw,48px)/1.18 Georgia,serif; letter-spacing:-.03em; }
    .brand-statement > .container > p:last-child { margin:5px 0 0; color:#c7cdd1; font-size:14px; line-height:1.7; }

    .brand-paths { padding:96px 0 112px; }
    .brand-paths-intro { display:grid; grid-template-columns:.55fr 1.45fr; gap:52px; margin-bottom:40px; }
    .brand-paths-intro h2 { font-size:clamp(36px,4vw,48px); line-height:1.08; }
    .brand-path-grid { display:grid; grid-template-columns:repeat(4,1fr); border-top:1px solid var(--line); border-bottom:1px solid var(--line); }
    .brand-path-grid a { min-height:220px; display:flex; flex-direction:column; padding:27px 28px 28px 0; }
    .brand-path-grid a + a { border-left:1px solid var(--line); padding-left:28px; }
    .brand-path-grid span { color:var(--amber); font-size:11px; font-weight:800; letter-spacing:.14em; }
    .brand-path-grid strong { margin-top:43px; font:400 25px/1.15 Georgia,serif; }
    .brand-path-grid small { margin-top:8px; color:var(--muted); font-size:14px; }
    .brand-path-grid b { margin-top:auto; padding-top:26px; font-size:13px; }
    .brand-path-grid a:hover strong, .brand-path-grid a:hover b { color:var(--blue); }

    @media (max-width: 900px) {
      .brand-hero { min-height:auto; }
      .brand-hero-grid { grid-template-columns:1fr; gap:52px; padding:66px 0 74px; }
      .brand-portrait { max-width:470px; }
      .brand-statement-grid { grid-template-columns:1fr; gap:24px; }
      .brand-path-grid { grid-template-columns:1fr 1fr; }
      .brand-path-grid a:nth-child(3) { border-left:0; border-top:1px solid var(--line); padding-left:0; }
      .brand-path-grid a:nth-child(4) { border-top:1px solid var(--line); }
    }
    @media (max-width: 600px) {
      .brand-hero-grid { padding-top:52px; }
      .brand-hero h1 { font-size:52px; }
      .brand-hero-lede { font-size:17px; }
      .brand-hero-actions { align-items:flex-start; flex-direction:column; gap:22px; }
      .brand-portrait figcaption { flex-direction:column; gap:4px; }
      .brand-statement { padding:62px 0; }
      .brand-paths { padding:72px 0 84px; }
      .brand-paths-intro { grid-template-columns:1fr; gap:14px; }
      .brand-path-grid { grid-template-columns:1fr; }
      .brand-path-grid a, .brand-path-grid a + a, .brand-path-grid a:nth-child(3) { min-height:175px; border-left:0; border-top:1px solid var(--line); padding:25px 0; }
      .brand-path-grid a:first-child { border-top:0; }
      .brand-path-grid strong { margin-top:25px; }
    }
  </style>
</BaseLayout>
