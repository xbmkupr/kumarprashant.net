---
import BaseLayout from '../layouts/BaseLayout.astro';
---
<BaseLayout>
  <section class="hero">
    <div class="container">
      <p class="eyebrow">Enterprise strategy · Architecture · AI</p>
      <h1>Turning complex technology choices into practical direction.</h1>
      <p class="lede">I work at the intersection of enterprise strategy and architecture — modernising complex technology estates, navigating major technology choices, and harnessing AI responsibly while balancing resilience, regulation, cost and long-term optionality.</p>
      <div class="actions">
        <a class="button primary" href="/lab/">Explore the Architecture Lab</a>
        <a class="button" href="/writing/">Read my writing</a>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <p class="eyebrow">Architecture Lab</p>
      <h2>Learning by building.</h2>
      <p class="section-intro">Small, practical experiments exploring how enterprise architecture, data, AI and customer platforms behave when ideas meet implementation.</p>
      <div class="grid">
        <article class="card">
          <div><p class="meta">Experiment 01</p><h3>CRM Prototype Studio</h3><p>AI-assisted enterprise delivery across Salesforce, Snowflake and governed human approvals.</p></div>
          <a class="card-link" href="/lab/">View experiment →</a>
        </article>
        <article class="card">
          <div><p class="meta">Experiment 02</p><h3>Conversational Utility Experience</h3><p>Exploring how outage and planned-work capabilities can be exposed beyond traditional web portals.</p></div>
          <a class="card-link" href="/lab/">View experiment →</a>
        </article>
        <article class="card">
          <div><p class="meta">Coming next</p><h3>Customer Event Digital Twin</h3><p>A responsive customer platform driven by operational events, enterprise context and governed AI assistance.</p></div>
          <a class="card-link" href="/lab/">Follow the lab →</a>
        </article>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container split">
      <div>
        <p class="eyebrow">Writing</p>
        <h2>Ideas worth pressure-testing.</h2>
        <p>I write about enterprise architecture, AI, transformation, optionality and what changes when emerging technology meets the constraints of real organisations.</p>
        <a class="card-link" href="/writing/">Browse writing →</a>
      </div>
      <div class="subscribe">
        <p class="eyebrow">Architecture Notes</p>
        <h2>Thinking in public.</h2>
        <p>Occasional notes on enterprise architecture, AI and technology transformation — grounded in practical experiments, prototypes and lessons learned.</p>
        <form class="subscribe-form" action="https://buttondown.com/api/emails/embed-subscribe/kprashant" method="post">
          <label class="sr-only" for="subscribe-email">Email address</label>
          <input id="subscribe-email" type="email" name="email" placeholder="Your email address" autocomplete="email" required />
          <input type="hidden" name="embed" value="1" />
          <input type="hidden" name="utm_source" value="kumarprashant.net" />
          <input type="hidden" name="utm_medium" value="website" />
          <button type="submit">Subscribe</button>
        </form>
        <p class="subscribe-note">No weekly promise. Just worthwhile notes when there is something useful to share.</p>
      </div>
    </div>
  </section>
</BaseLayout>
