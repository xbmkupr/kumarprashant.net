---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';

const experiments = (await getCollection('experiments')).sort((a,b) => a.data.experimentNo - b.data.experimentNo);
const publishedRank = (value) => {
  if (!value) return 0;
  if (value instanceof Date) return value.getTime();
  if (/^\d{4}-\d{2}-\d{2}$/.test(value)) return new Date(`${value}T00:00:00Z`).getTime();
  const parsed = new Date(value);
  return Number.isNaN(parsed.getTime()) ? 0 : parsed.getTime();
};
const publishedWriting = (await getCollection('writing', ({ data }) => data.status === 'published'))
  .sort((a,b) => publishedRank(b.data.published) - publishedRank(a.data.published))
  .slice(0, 3);
---
<BaseLayout>
  <section class="home-hero container">
    <div>
      <p class="eyebrow">Enterprise strategy · Architecture · AI</p>
      <h1>The future refuses<br/>to follow the <em>roadmap.</em></h1>
      <p class="lede">I help organisations make consequential technology choices with clarity — connecting strategy, architecture and delivery while preserving the freedom to adapt.</p>
      <div class="hero-actions">
        <a class="button button-dark" href="/writing/">Read my thinking</a>
        <a class="text-link" href="/lab/">Explore the Architecture Lab →</a>
      </div>
    </div>
    <aside class="home-hero-side">
      <div class="brand-panel">
        <p class="eyebrow">How I work</p>
        <strong>Independent perspective. Strategy grounded in delivery.</strong>
        <p>My work sits where long-term strategy meets real-world constraints: legacy estates, regulation, competing priorities, emerging technology and decisions that are expensive to reverse.</p>
      </div>
    </aside>
  </section>

  <section class="signal-strip">
    <div class="container signal-inner">
      <span>Independent perspective</span><i></i>
      <span>20+ years across industries & continents</span><i></i>
      <span>Strategy grounded in delivery</span>
    </div>
  </section>

  <section class="section section--roomy">
    <div class="container">
      <div class="section-heading">
        <p class="eyebrow">Where I focus</p>
        <div>
          <h2>Complexity is inevitable.<br/><em>Confusion is optional.</em></h2>
          <p>I work at the point where long-term strategy meets real-world delivery: competing priorities, legacy constraints, emerging technology and choices that shape what remains possible later.</p>
        </div>
      </div>
      <div class="focus-grid">
        <article class="focus-card"><span>01</span><h3>Enterprise strategy</h3><p>Turning ambition, constraint and technology change into choices organisations can act on.</p></article>
        <article class="focus-card"><span>02</span><h3>AI & strategic optionality</h3><p>Using AI-enabled platforms for speed without surrendering control of data, intelligence or future choices.</p></article>
        <article class="focus-card"><span>03</span><h3>Architecture that moves</h3><p>Creating guardrails, operating models and roadmaps that help delivery move with greater coherence.</p></article>
      </div>
    </div>
  </section>

  <section class="quote-section">
    <div class="container quote-grid">
      <p class="eyebrow eyebrow-light">My point of view</p>
      <blockquote>“Architecture earns its place when it improves the quality, speed and reversibility of decisions.”</blockquote>
      <p class="quote-note">I am less interested in prescribing a perfect future than in helping organisations build the capability to navigate an uncertain one.</p>
    </div>
  </section>

  <section class="section section--roomy">
    <div class="container lab-feature">
      <div class="lab-feature-copy">
        <p class="eyebrow">Architecture Lab</p>
        <h2>Learning by building, not just reading.</h2>
        <p>The Lab turns architecture ideas into small working experiments. Each build is a way to test assumptions, expose trade-offs and create better enterprise conversations.</p>
        <a class="text-link" href="/lab/">Explore all experiments →</a>
      </div>
      <div class="lab-list">
        {experiments.slice(0,4).map((entry) => (
          <article>
            <span>Experiment {String(entry.data.experimentNo).padStart(2,'0')}</span>
            <div><h3>{entry.data.title}</h3><p>{entry.data.summary ?? entry.data.description}</p></div>
            {entry.data.status === 'published' ? <a href={`/lab/${entry.id}/`}>View →</a> : <a href="/lab/">Roadmap</a>}
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container split">
      <div>
        <p class="eyebrow">Writing</p>
        <h2>Ideas for decisions that outlive the slide deck.</h2>
        <p class="section-intro">I write about enterprise strategy, architecture, AI, data, platforms and the judgement required when there is no perfect answer.</p>
        <div class="writing-list">
          {publishedWriting.map((entry) => (
            <a class="writing-row" href={`/writing/${entry.id}/`}>
              <div><p class="meta">{entry.data.category ?? 'Writing'}</p><h2>{entry.data.title}</h2><p>{entry.data.summary ?? entry.data.description}</p></div>
              <span class="writing-status">Read →</span>
            </a>
          ))}
        </div>
        <p><a class="text-link" href="/writing/">View all writing →</a></p>
      </div>
      <aside class="subscribe">
        <p class="eyebrow">Architecture Notes</p>
        <h2>Thinking in public.</h2>
        <p>Occasional notes on enterprise architecture, AI and technology transformation — grounded in practical experiments, prototypes and lessons learned.</p>
        <form class="subscribe-form" action="https://buttondown.com/api/emails/embed-subscribe/kprashant" method="post">
          <label class="sr-only" for="subscribe-email">Email address</label>
          <input id="subscribe-email" type="email" name="email" placeholder="Your email address" autocomplete="email" required />
          <input type="hidden" name="embed" value="1" />
          <input type="hidden" name="utm_source" value="kumarprashant.net" />
          <input type="hidden" name="utm_medium" value="website" />
          <button type="submit">Subscribe</button>
        </form>
        <p class="subscribe-note">No weekly promise. Just worthwhile notes when there is something useful to share.</p>
      </aside>
    </div>
  </section>
</BaseLayout>
