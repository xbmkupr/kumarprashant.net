---
import BaseLayout from '../layouts/BaseLayout.astro';
---
<BaseLayout title="Subscription confirmed — Architecture Notes">
  <section class="hero compact-hero">
    <div class="container narrow">
      <p class="eyebrow">Architecture Notes</p>
      <h1>You’re subscribed.</h1>
      <p class="lede">Thanks for confirming. You’ll now receive new Architecture Notes when there is something useful to share — practical experiments, architecture perspectives and lessons learned.</p>
      <div class="actions">
        <a class="button primary" href="/writing/">Read the latest writing</a>
        <a class="button" href="/lab/">Explore the Architecture Lab</a>
      </div>
    </div>
  </section>
</BaseLayout>
