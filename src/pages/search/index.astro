---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';

const experiments = await getCollection('experiments');
const writing = await getCollection('writing');
const items = [
  ...experiments.map((entry) => ({
    title: entry.data.title,
    description: entry.data.summary ?? entry.data.description,
    tags: entry.data.tags,
    type: 'Architecture Lab',
    status: entry.data.status,
    href: entry.data.status === 'published' ? `/lab/${entry.id}/` : '/lab/'
  })),
  ...writing.map((entry) => ({
    title: entry.data.title,
    description: entry.data.summary ?? entry.data.description,
    tags: entry.data.tags,
    type: 'Writing',
    status: entry.data.status,
    href: entry.data.status === 'published' ? `/writing/${entry.id}/` : '/writing/'
  }))
];
---
<BaseLayout title="Search — Prashant Kumar" description="Search architecture experiments, writing and topics.">
  <section class="hero search-hero">
    <div class="container">
      <p class="eyebrow">Search</p>
      <h1>Find an idea, experiment or topic.</h1>
      <p class="lede">Search across Architecture Lab experiments and writing by title, description or tag.</p>
      <label class="sr-only" for="site-search">Search the site</label>
      <input class="site-search-input" id="site-search" type="search" placeholder="Try agentic AI, customer experience, Snowflake…" autocomplete="off" />
    </div>
  </section>
  <section class="section">
    <div class="container">
      <p class="search-count" id="search-count">{items.length} items</p>
      <div class="grid" id="search-results"></div>
      <p class="search-empty" id="search-empty" hidden>No matching content yet.</p>
    </div>
  </section>

  <script define:vars={{ items }}>
    const input = document.getElementById('site-search');
    const results = document.getElementById('search-results');
    const count = document.getElementById('search-count');
    const empty = document.getElementById('search-empty');

    const escapeHtml = (value) => String(value).replace(/[&<>'\"]/g, (char) => ({ '&':'&amp;', '<':'&lt;', '>':'&gt;', "'":'&#39;', '\"':'&quot;' }[char]));

    const render = () => {
      const query = input.value.trim().toLowerCase();
      const matched = items.filter((item) => {
        const haystack = [item.title, item.description, item.type, item.status, ...item.tags].join(' ').toLowerCase();
        return !query || haystack.includes(query);
      });
      count.textContent = `${matched.length} ${matched.length === 1 ? 'item' : 'items'}`;
      empty.hidden = matched.length !== 0;
      results.innerHTML = matched.map((item) => `
        <article class="card">
          <div>
            <p class="meta">${escapeHtml(item.type)} · ${escapeHtml(item.status)}</p>
            <h3>${escapeHtml(item.title)}</h3>
            <p>${escapeHtml(item.description)}</p>
            <div class="tag-list">${item.tags.slice(0,4).map((tag) => `<span class="tag-pill">${escapeHtml(tag)}</span>`).join('')}</div>
          </div>
          <a class="card-link" href="${item.href}">${item.status === 'published' ? 'Open →' : 'View roadmap →'}</a>
        </article>`).join('');
    };
    input.addEventListener('input', render);
    render();
  </script>
</BaseLayout>
