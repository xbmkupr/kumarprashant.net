---
import BaseLayout from '../layouts/BaseLayout.astro';
---
<BaseLayout title="Check your inbox — Architecture Notes">
  <section class="hero compact-hero">
    <div class="container narrow">
      <p class="eyebrow">Architecture Notes</p>
      <h1>Check your inbox.</h1>
      <p class="lede">Thanks for subscribing. Buttondown will send a confirmation email to the address you entered. Click the confirmation link to activate your subscription.</p>
      <div class="actions">
        <a class="button primary" href="/writing/">Browse writing</a>
        <a class="button" href="/lab/">Explore the Architecture Lab</a>
      </div>
    </div>
  </section>
</BaseLayout>
