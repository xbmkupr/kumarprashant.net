---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import SectionMark from '../../components/SectionMark.astro';

const entries = await getCollection('writing');
const published = entries.filter((entry) => entry.data.status === 'published');
const planned = entries.filter((entry) => entry.data.status !== 'published');

const publishedRank = (value) => {
  if (!value) return 0;
  if (value instanceof Date) return value.getTime();
  if (/^\d{4}-\d{2}-\d{2}$/.test(value)) return new Date(`${value}T00:00:00Z`).getTime();
  const parsed = new Date(value);
  return Number.isNaN(parsed.getTime()) ? 0 : parsed.getTime();
};

published.sort((a,b) => publishedRank(b.data.published) - publishedRank(a.data.published));

const displayDate = (value) => {
  if (!value) return '';
  const date = value instanceof Date ? value : (/^\d{4}-\d{2}-\d{2}$/.test(value) ? new Date(`${value}T00:00:00Z`) : null);
  return date ? new Intl.DateTimeFormat('en-AU',{day:'numeric',month:'long',year:'numeric',timeZone:'UTC'}).format(date) : value;
};

const uniqueLabels = (entry) => {
  const labels = [entry.data.category ?? 'Writing', ...entry.data.tags];
  const seen = new Set();
  return labels.filter((label) => {
    const key = String(label).trim().toLowerCase();
    if (!key || seen.has(key)) return false;
    seen.add(key);
    return true;
  });
};

const displayMeta = (entry) => uniqueLabels(entry).slice(0, 3).join(' · ');
const topicKey = (value) => String(value).trim().toLowerCase();
const topics = [...new Set(published.flatMap((entry) => entry.data.tags.map((tag) => String(tag).trim())).filter(Boolean))].sort((a,b) => a.localeCompare(b));
const recentLimit = 8;
const hasOlder = published.length > recentLimit;
---
<BaseLayout title="Writing — Prashant Kumar" description="Ideas on enterprise strategy, architecture, AI, data, platforms and strategic optionality.">
  <section class="hero writing-hero">
    <div class="container">
      <div class="section-identity"><SectionMark kind="writing" size="md" tone="blue" /><p class="eyebrow">Writing</p></div>
      <h1>Ideas for decisions<br/>that outlive the slide deck.</h1>
      <p class="lede">I write about the choices beneath enterprise transformation — where architecture, AI, data, platforms and organisational judgement meet.</p>
    </div>
  </section>

  <section class="section writing-index-section">
    <div class="container">
      <div class="writing-index-head">
        <div>
          <p class="eyebrow">Latest writing</p>
          <h2>Thinking in public.</h2>
        </div>
        <a class="text-link writing-archive-link" href="/archive/">Browse the full archive →</a>
      </div>

      {topics.length > 0 && (
        <div class="writing-topics" aria-label="Filter writing by topic">
          <button class="filter-chip is-active" type="button" data-writing-filter="all">All</button>
          {topics.map((topic) => (
            <button class="filter-chip" type="button" data-writing-filter={topicKey(topic)}>{topic}</button>
          ))}
        </div>
      )}

      <p class="writing-filter-status" aria-live="polite"></p>

      <div class="writing-list writing-index-list">
        {published.map((entry, index) => (
          <a
            class="writing-row writing-index-row"
            href={`/writing/${entry.id}/`}
            data-writing-row
            data-recent={index < recentLimit ? 'true' : 'false'}
            data-topics={entry.data.tags.map(topicKey).join('|')}
          >
            <div>
              <p class="meta">{displayMeta(entry)}</p>
              <h2>{entry.data.title}</h2>
              <p>{entry.data.summary ?? entry.data.description}</p>
            </div>
            <time>{displayDate(entry.data.published)}</time>
          </a>
        ))}
      </div>

      {hasOlder && (
        <p class="writing-more-note">Showing the latest {recentLimit} pieces. Older writing remains available in the <a href="/archive/">Archive</a> and through topic filters.</p>
      )}

      {planned.length > 0 && (
        <section class="planned-writing planned-writing--quiet">
          <div class="planned-writing-head">
            <div>
              <p class="eyebrow">Taking shape</p>
              <h2>Ideas I’m still pressure-testing.</h2>
            </div>
            <p>Early ideas, not promises. Some will become articles; others may change completely.</p>
          </div>
          <div class="writing-ideas-list">
            {planned.map((entry) => (
              <article>
                <span>{entry.data.status}</span>
                <h3>{entry.data.title}</h3>
                <p>{entry.data.summary ?? entry.data.description}</p>
              </article>
            ))}
          </div>
        </section>
      )}
    </div>
  </section>

  <script>
    const buttons = [...document.querySelectorAll('[data-writing-filter]')];
    const rows = [...document.querySelectorAll('[data-writing-row]')];
    const status = document.querySelector('.writing-filter-status');

    const applyFilter = (filter) => {
      let visible = 0;
      rows.forEach((row) => {
        const topics = (row.dataset.topics || '').split('|').filter(Boolean);
        const show = filter === 'all' ? row.dataset.recent === 'true' : topics.includes(filter);
        row.hidden = !show;
        if (show) visible += 1;
      });

      buttons.forEach((button) => button.classList.toggle('is-active', button.dataset.writingFilter === filter));
      if (status) status.textContent = filter === 'all' ? '' : `${visible} ${visible === 1 ? 'article' : 'articles'} in this topic`;
    };

    buttons.forEach((button) => button.addEventListener('click', () => applyFilter(button.dataset.writingFilter || 'all')));
    applyFilter('all');
  </script>
</BaseLayout>
