---
import BaseLayout from './BaseLayout.astro';
import GiscusComments from '../components/GiscusComments.astro';

const {
  title,
  description,
  eyebrow = 'Writing',
  published,
  updated,
  tags = [],
  image = '/social-card.png',
  comments = true
} = Astro.props;

const shareUrl = new URL(Astro.url.pathname, Astro.site).toString();
const linkedInShare = `https://www.linkedin.com/sharing/share-offsite/?url=${encodeURIComponent(shareUrl)}`;
const emailShare = `mailto:?subject=${encodeURIComponent(title)}&body=${encodeURIComponent(`${title}\n\n${shareUrl}`)}`;
const tagSlug = (tag) => tag.toLowerCase().replace(/[^a-z0-9]+/g, '-').replace(/^-|-$/g, '');
const formatDate = (value) => {
  if (!value) return value;
  if (value instanceof Date) {
    return new Intl.DateTimeFormat('en-AU', { day: 'numeric', month: 'long', year: 'numeric', timeZone: 'UTC' }).format(value);
  }
  if (typeof value !== 'string') return String(value);
  const iso = /^\d{4}-\d{2}-\d{2}$/.test(value);
  if (!iso) return value;
  const [year, month, day] = value.split('-').map(Number);
  return new Intl.DateTimeFormat('en-AU', { day: 'numeric', month: 'long', year: 'numeric', timeZone: 'UTC' }).format(new Date(Date.UTC(year, month - 1, day)));
};
---
<BaseLayout title={`${title} — Prashant Kumar`} description={description} image={image}>
  <article class="prose article-page">
    <aside class="share-rail" aria-label="Share this article">
      <span class="share-rail-label">Share</span>
      <a href={linkedInShare} target="_blank" rel="noopener noreferrer">LinkedIn</a>
      <a href={emailShare}>Email</a>
      <a class="copy-link" href={shareUrl} data-copy-url={shareUrl}>Copy link</a>
    </aside>

    <header class="article-header">
      <p class="eyebrow">{eyebrow}</p>
      <h1>{title}</h1>
      {description && <p class="lede">{description}</p>}
      {(published || updated) && (
        <p class="article-date">
          {published && <>Published {formatDate(published)}</>}
          {published && updated && <> · </>}
          {updated && <>Updated {formatDate(updated)}</>}
        </p>
      )}
      {tags.length > 0 && (
        <div class="tag-list article-tags" aria-label="Topics">
          {tags.map((tag) => <a class="tag-pill" href={`/tags/${tagSlug(tag)}/`}>{tag}</a>)}
        </div>
      )}
    </header>

    <slot />

    <aside class="share-panel" aria-labelledby="share-heading">
      <h2 id="share-heading">Share this article.</h2>
      <p>If this gave you a useful idea, pass it on to someone who might see it differently.</p>
      <nav class="share-links" aria-label="Share this article">
        <a href={linkedInShare} target="_blank" rel="noopener noreferrer">LinkedIn</a>
        <span aria-hidden="true">·</span>
        <a href={emailShare}>Email</a>
        <span aria-hidden="true">·</span>
        <a class="copy-link" href={shareUrl} data-copy-url={shareUrl}>Copy link</a>
      </nav>
    </aside>

    <aside class="article-subscribe">
      <p class="eyebrow">Architecture Notes</p>
      <h2>More practical notes, occasionally.</h2>
      <p>Enterprise architecture, AI and technology transformation — grounded in experiments, prototypes and lessons learned.</p>
      <form action="https://buttondown.com/api/emails/embed-subscribe/kprashant" method="post" target="popupwindow" onsubmit="window.open('https://buttondown.com/kprashant', 'popupwindow')" class="subscribe-form">
        <label class="sr-only" for="article-email">Email address</label>
        <input id="article-email" type="email" name="email" placeholder="you@example.com" required />
        <input type="hidden" name="tag" value="website-article" />
        <button type="submit">Subscribe</button>
      </form>
    </aside>

    {comments && <GiscusComments />}
  </article>

  <script is:inline>
    document.querySelectorAll('.copy-link').forEach((link) => {
      link.addEventListener('click', async (event) => {
        event.preventDefault();
        const url = link.getAttribute('data-copy-url');
        if (!url) return;
        try {
          await navigator.clipboard.writeText(url);
          const original = link.textContent;
          link.textContent = 'Copied';
          setTimeout(() => (link.textContent = original), 1500);
        } catch {
          window.prompt('Copy this link:', url);
        }
      });
    });
  </script>
</BaseLayout>
