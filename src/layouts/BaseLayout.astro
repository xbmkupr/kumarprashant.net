---
import { ClientRouter } from 'astro:transitions';
import '../styles/global.css';
import '../styles/content.css';
import '../styles/experience.css';
import '../styles/writing.css';
import '../styles/icons.css';
import '../styles/overrides.css';
const {
  title = 'Prashant Kumar — Enterprise Strategy & Architecture',
  description = 'Enterprise strategy, architecture and responsible AI — practical thinking, experiments and writing from Prashant Kumar.',
  image = '/social-card.jpg',
  type = 'website'
} = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
const socialImage = new URL(image, Astro.site);
const pathname = Astro.url.pathname;
const isActive = (section) => pathname === section || pathname.startsWith(`${section}/`);
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />

    <meta property="og:type" content={type} />
    <meta property="og:site_name" content="Prashant Kumar" />
    <meta property="og:locale" content="en_AU" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={socialImage} />
    <meta property="og:image:url" content={socialImage} />
    <meta property="og:image:secure_url" content={socialImage} />
    <meta property="og:image:type" content="image/jpeg" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="627" />
    <meta property="og:image:alt" content="Prashant Kumar — Enterprise Strategy, Architecture and Responsible AI" />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={socialImage} />
    <meta name="twitter:image:alt" content="Prashant Kumar — Enterprise Strategy, Architecture and Responsible AI" />

    <ClientRouter />
    <title>{title}</title>
  </head>
  <body>
    <header class="site-header">
      <div class="site-shell header-inner">
        <a class="brand" href="/" aria-label="Prashant Kumar home">
          <span class="brand-mark">PK</span>
          <strong>Prashant Kumar</strong>
        </a>
        <div class="header-actions">
          <nav class="nav" aria-label="Primary navigation">
            <a class:list={{ 'nav-active': isActive('/lab') }} aria-current={isActive('/lab') ? 'page' : undefined} href="/lab/">Architecture Lab</a>
            <a class:list={{ 'nav-active': isActive('/writing') }} aria-current={isActive('/writing') ? 'page' : undefined} href="/writing/">Writing</a>
            <a class:list={{ 'nav-active': isActive('/experience') }} aria-current={isActive('/experience') ? 'page' : undefined} href="/experience/">Experience</a>
            <a class:list={{ 'nav-active': isActive('/about') }} aria-current={isActive('/about') ? 'page' : undefined} href="/about/">About</a>
            <a class:list={{ 'nav-secondary': true, 'nav-active': isActive('/archive') }} aria-current={isActive('/archive') ? 'page' : undefined} href="/archive/">Archive</a>
          </nav>
          <a class:list={{ 'site-search-link': true, 'site-search-link--active': isActive('/search') }} aria-current={isActive('/search') ? 'page' : undefined} href="/search/" aria-label="Search the site">
            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="m21 21-4.35-4.35m1.35-5.65a7 7 0 1 1-14 0 7 7 0 0 1 14 0Z" /></svg>
            <span>Search</span>
          </a>
        </div>
      </div>
      <nav class="site-shell mobile-nav" aria-label="Mobile primary navigation">
        <a class:list={{ 'nav-active': isActive('/lab') }} aria-current={isActive('/lab') ? 'page' : undefined} href="/lab/">Lab</a>
        <a class:list={{ 'nav-active': isActive('/writing') }} aria-current={isActive('/writing') ? 'page' : undefined} href="/writing/">Writing</a>
        <a class:list={{ 'nav-active': isActive('/experience') }} aria-current={isActive('/experience') ? 'page' : undefined} href="/experience/">Experience</a>
        <a class:list={{ 'nav-active': isActive('/about') }} aria-current={isActive('/about') ? 'page' : undefined} href="/about/">About</a>
        <a class:list={{ 'nav-active': isActive('/archive') }} aria-current={isActive('/archive') ? 'page' : undefined} href="/archive/">Archive</a>
      </nav>
    </header>
    <main><slot /></main>
    <footer class="site-footer site-footer--compact">
      <div class="site-shell compact-footer-row">
        <div class="compact-footer-copy">
          <p class="eyebrow">Continue the conversation</p>
          <h2>Ideas get better when they are challenged.</h2>
        </div>
        <div class="compact-footer-actions">
          <a class="text-link" href="https://www.linkedin.com/in/k-prashant/" target="_blank" rel="noreferrer">LinkedIn ↗</a>
          <a class="text-link" href="mailto:hello@kumarprashant.net">Email me →</a>
        </div>
      </div>
      <div class="site-shell footer-bottom">
        <span>© {new Date().getFullYear()} Prashant Kumar</span>
        <span>Adelaide, Australia · Working globally · <a href="/privacy/">Privacy</a></span>
      </div>
    </footer>
  </body>
</html>
